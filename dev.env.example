PHP_SHOW_ERR=On
PHP_CACHE=Off
PHP_SECURE_COOKIES=Off
PHP_ERROR_REPORTING=32767
PHP_ASSERTIONS=1
LOG_LEVEL=debug
LOG_FORMAT=text
# the dev container has a live SMTP and may hold a copy of the production data: the daily cron of the image stays off
# (run script/cron.php by hand, with a dead SMTP, see CLAUDE.md)
CRON_ENABLED=false
# the demo buttons of the sign-in page work (the hourly reset only runs when CRON_ENABLED is on)
DEMO_ENABLED=true
